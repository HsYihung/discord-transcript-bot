# Discord Bot 設定
DISCORD_TOKEN=你的_bot_token
CLIENT_ID=你的_application_id
# 註冊 slash command 的伺服器（開發用，留空則註冊為全域指令）
GUILD_ID=

# ── STT（語音轉文字）設定 ──────────────────────────────
# 可選值: openai-whisper | speechmatics | dummy（擴充見 src/stt/index.js）
STT_PROVIDER=openai-whisper
# 辨識語言（ISO-639-1，例如 zh / en / ja，留空為自動偵測）
STT_LANGUAGE=zh
# Whisper 系引擎的引導詞。內容可能滲漏進辨識結果，繁體已由 OpenCC 處理，通常留空
STT_PROMPT=

# ── 預設：本地 Qwen3-ASR（先啟動 npm run asr-server）───
OPENAI_API_KEY=local-qwen
OPENAI_BASE_URL=http://127.0.0.1:8765/v1
OPENAI_STT_MODEL=Qwen/Qwen3-ASR-1.7B
# 本地推理不需要限速排隊
STT_MIN_INTERVAL_MS=0

# ── 替代：Groq 雲端（免費層，把上面四行換成以下）───────
# OPENAI_API_KEY=你的_gsk_key（https://console.groq.com）
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_STT_MODEL=whisper-large-v3
# STT_MIN_INTERVAL_MS=3200   # 免費層 20 RPM

# ── 替代：Speechmatics（免費 480 分/月）────────────────
# SPEECHMATICS_API_KEY=（https://portal.speechmatics.com）
# SPEECHMATICS_REGION=eu1
# SPEECHMATICS_LANGUAGE=cmn_en
# SPEECHMATICS_OUTPUT_LOCALE=cmn-Hant
# SPEECHMATICS_OPERATING_POINT=enhanced

# ── 段落與雜音控制 ────────────────────────────────────
# 靜音多久視為段落結束（毫秒）
SILENCE_DURATION_MS=1500
# 短於此長度的段落當雜音丟棄（毫秒）
MIN_SEGMENT_MS=300
# 最大視窗音量（RMS）低於此值的段落當雜音丟棄
MIN_SEGMENT_RMS=300
# 同發言者間隔內的發言合併送辨識（毫秒）；0 = 停用，每段獨立成行
MERGE_GAP_MS=0
# 單一合併批次的音訊長度上限（毫秒）
MAX_MERGED_DURATION_MS=120000

# ── 輸出 ─────────────────────────────────────────────
TRANSCRIPT_DIR=transcripts
# 設 1 時每批送辨識的音訊存到 recordings/（除錯用，注意磁碟與隱私）
DEBUG_SAVE_AUDIO=
