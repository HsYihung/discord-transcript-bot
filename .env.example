# Discord Bot 設定
DISCORD_TOKEN=你的_bot_token
CLIENT_ID=你的_application_id
# 註冊 slash command 的伺服器（開發用，留空則註冊為全域指令）
GUILD_ID=

# STT（語音轉文字）設定
# 可選值: typeless | openai-whisper | dummy（自行擴充見 src/stt/index.js）
STT_PROVIDER=typeless
# 辨識語言（ISO-639-1，例如 zh / en / ja，留空為自動偵測）
STT_LANGUAGE=zh
# 引導辨識輸出風格（繁簡、專有名詞拼法），Whisper 系列支援
STT_PROMPT=以下是台灣繁體中文的對話，內容夾雜英文技術名詞。

# typeless provider 需要（API key 到 https://platform.typelessapi.com 申請，tls_sk_ 開頭）
TYPELESS_API_KEY=
TYPELESS_BASE_URL=https://api.typelessapi.com
# 可選模型: typeless-1.0-lite | typeless-1.0-pro | typeless-1.0-max
TYPELESS_MODEL=typeless-1.0-pro

# openai-whisper provider 需要
OPENAI_API_KEY=
# 可自訂 API base（相容 API 如 Groq 也可用）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
